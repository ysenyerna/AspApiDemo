@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Recent Posts</h1>
	<p id="post-count">Total Posts: </p>
</div>
<div id="posts-container"></div>

<script>

// Add some example posts
async function addPosts() {
	const examplePosts = [
		{ title: "First Post", content: "Hello World" },
		{ title: "Second Post", content: "This is the second post..."},
		{ title: "Another Post", content: "This is the third post."}
	];

	// Post each post to the API
	for (const post of examplePosts ) {
		await fetch("/api/posts", {
			method: "POST",
			headers: { "Content-Type": "application/json"},
			body: JSON.stringify(post)
		});
	}
}

// Read and display the posts
async function readPosts() {
	// Read posts
	const response = await fetch("/api/posts");
	const posts = await response.json();

	// Display post count
	document.getElementById("post-count").textContent = "Total Posts: " + posts.length;

	// Display posts dynamically from most recent
	posts.reverse().forEach(post => {
		const element = document.createElement("p");
		element.classList.add("post");
		element.textContent = post.title;
		document.getElementById("posts-container").appendChild(element);
	});
}

// Run functions
addPosts()
.then(readPosts);

</script>